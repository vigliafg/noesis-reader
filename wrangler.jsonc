{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noesis-reader",
  "compatibility_date": "2026-08-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "upload": {
    "exclude": [
      "node_modules/**",
      // Build inputs — index.html/noesis-editor.html are generated FROM these, so
      // shipping them would just serve a second, unused copy of the whole app.
      "src/**",
      "build/**",
      "package.json",
      "package-lock.json",
      ".gitignore",
      ".wrangler/**",
      "*.epub",
      "*.pdf",
      "test/**",
      "*.md",
      ".gitattributes",
      ".gitignore",
      "noesis-reader.png",
      "_create_test_files.py",
      "server.log",
      "package.json",
      "package-lock.json"
    ]
  }
}
