# Dependencies / tooling
node_modules/
.wrangler/

# Large test fixtures (too big for the Cloudflare Workers 25MB limit)
test*.epub
test*.pdf

# Scratch test scripts. The real suites and the test runner are tracked; anything
# else matching test*.js is assumed to be a throwaway.
test*.js
!test_e2e_complete.js
!test_editor_toolbar.js
!build/test.js

# Test run artifacts (rewritten on every `npm test`)
test_e2e_report.json
test_editor_toolbar_report.json

# Logs
server.log

# NOTE: there is deliberately no `*.md` rule here. There used to be, and it meant new
# documentation was silently untracked unless someone remembered `git add -f` — which is
# how src/README.md nearly went missing. Docs in this repo are meant to be committed.
# Deploys exclude *.md separately, in wrangler.jsonc.
